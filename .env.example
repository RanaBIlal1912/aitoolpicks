# Optional settings. Copy to .env.local for local use, or set them in the deploy workflow.
# Public contact email shown on the Contact page. Leave empty to use GitHub issues instead.
NEXT_PUBLIC_CONTACT_EMAIL=
# Only needed for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://example.com
# NEXT_PUBLIC_BASE_PATH=

# --- Platform upgrade (database). Server-side only: never prefix these with NEXT_PUBLIC_. Copy to .env.local, which is git-ignored. ---
# Runtime queries. On Supabase this is the transaction pooler (port 6543). A local test database also works.
# DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/aitoolpicks
# Migrations, import and backups. On Supabase: the session pooler or direct connection (port 5432). Falls back to DATABASE_URL.
# DATABASE_DIRECT_URL=
# "require" for hosted databases (the default), "disable" for a local one (the default for localhost).
# DATABASE_SSL=require
# Later phases (authentication, hosting). Documented here so the names are fixed; nothing reads them yet.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# CONTENT_SOURCE=json
# ANALYTICS_ENABLED=false
