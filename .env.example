# Optional settings. Copy to .env.local for local use, or set them in the deploy workflow.
# Public contact email shown on the Contact page. Leave empty to use GitHub issues instead.
NEXT_PUBLIC_CONTACT_EMAIL=
# Only needed for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://example.com
# NEXT_PUBLIC_BASE_PATH=
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave unset and analytics is completely off: no banner, no scripts, no cookies.
# When set, a consent banner asks first and nothing loads until the visitor allows it. Set it on the build step only (not the whole job: a test expects it unset).
# NEXT_PUBLIC_GA_ID=
# Analytics also needs ALL of these, so it cannot go live by accident. Leave them unset until the owner has decided.
# NEXT_PUBLIC_OPERATOR_NAME=      the name to publish as the operator on /privacy/ (the owner's own)
# NEXT_PUBLIC_PRIVACY_CONTACT=    a private way to reach the operator about personal data (an email address or an https link)
# NEXT_PUBLIC_ANALYTICS_APPROVED= set to exactly "yes" only after the legal and Google account decisions in docs/LAUNCH_CHECKLIST.md
