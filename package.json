{
  "name": "aitoolpicks",
  "version": "2.0.0",
  "private": true,
  "description": "AI Tool Picks: honest guides, reviews and comparisons of AI tools for freelancers and small businesses.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "node scripts/build-catalog.mjs && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "postbuild": "node scripts/legacy-redirects.mjs",
    "covers": "vite --config scripts/covers/vite.config.mts",
    "catalog": "node scripts/build-catalog.mjs",
    "logos": "node scripts/fetch-logos.mjs",
    "brand": "node scripts/make-brand-assets.mjs",
    "news-images": "node scripts/fetch-news-images.mjs",
    "tool-images": "node scripts/fetch-tool-images.mjs",
    "assets:report": "node scripts/assets-report.mjs",
    "catalog:report": "node scripts/build-catalog.mjs --report",
    "prebuild": "node scripts/build-catalog.mjs",
    "predev": "node scripts/build-catalog.mjs",
    "affiliate:report": "node scripts/affiliate-report.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/migrate.ts",
    "db:health": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db/health.ts",
    "lint": "eslint .",
    "migrate:backup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate/backup.ts",
    "migrate:catalogue": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate/catalogue.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20.9"
  }
}
