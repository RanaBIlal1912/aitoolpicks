{
  "name": "aitoolpicks",
  "version": "2.0.0",
  "private": true,
  "description": "AI Tool Picks: honest guides, reviews and comparisons of AI tools for freelancers and small businesses.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "node scripts/build-catalog.mjs && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "postbuild": "node scripts/legacy-redirects.mjs",
    "covers": "vite --config scripts/covers/vite.config.mts",
    "catalog": "node scripts/build-catalog.mjs",
    "logos": "node scripts/fetch-logos.mjs",
    "brand": "node scripts/make-brand-assets.mjs",
    "catalog:report": "node scripts/build-catalog.mjs --report",
    "prebuild": "node scripts/build-catalog.mjs",
    "predev": "node scripts/build-catalog.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "framer-motion": "^12.43.0",
    "lenis": "^1.3.27",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
